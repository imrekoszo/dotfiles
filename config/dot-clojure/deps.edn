                                            io.aviso/pretty {:mvn/version "1.4.4"},
                                            vlaaad/reveal {:mvn/version "1.3.327"},
                                            criterium/criterium {:mvn/version "0.4.6"}},
                               :jvm-opts ["-Djdk.attach.allowAttachSelf"
                                          "-XX:+UnlockDiagnosticVMOptions"
                                          "-XX:+DebugNonSafepoints"
                                          "-Dvlaaad.reveal.prefs={:theme :light :font-family \"JetBrains Mono\" :font-size 15}"]},
           :performance/memory-meter {:extra-deps {com.clojure-goes-fast/clj-memory-meter {:mvn/version "0.4.0"}},
                                      :jvm-opts ["-Djdk.attach.allowAttachSelf"]},
           :lib/reveal {:extra-deps {vlaaad/reveal {:mvn/version "1.3.327"}},
                        :jvm-opts ["-Dvlaaad.reveal.prefs={:theme :light :font-family \"JetBrains Mono\" :font-size 15}"]},
           :imre/outdated {:replace-paths ["."],
                           :replace-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"},
