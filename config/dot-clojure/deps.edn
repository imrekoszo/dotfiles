{:aliases {:performance/benchmark {:extra-deps {criterium/criterium {:mvn/version "0.4.6"}}},
           :alpha/reflect {:extra-deps {com.stuarthalloway/reflector {:git/url "https://github.com/stuarthalloway/reflector",
                                                                      :sha "93a0c19b4526c1180959e940202928d35e5c3cef"}}},
           :imre/lombok {:extra-deps {org.projectlombok/lombok {:mvn/version "1.18.46"}}},
